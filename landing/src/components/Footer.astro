---
import { appUrl, signupUrl, brandName, wordmarkHead, wordmarkTail } from '../lib/site';
import Mark from './Mark.astro';
import content from '../lib/content';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="wordmark"><Mark size={19} id="ov-mark-f" /> {wordmarkHead}<span class="gradient-text">{wordmarkTail}</span></span>
      <p class="footer-tagline" set:html={content.footer.tagline} />
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-col">
        <h3>Product</h3>
        <a href="/#two-ways">The choice</a>
        <a href="/#projects">Projects</a>
        <a href="/#programs">Programs</a>
        <a href="/#how-it-works">How it works</a>
        <a href="/#pricing">Pricing</a>
        <a href="/#sovereign">Trust</a>
        <a href="/sota">Security &amp; SOTA</a>
      </div>
      <div class="footer-col">
        <h3>Get started</h3>
        <a href={signupUrl}>Create an account</a>
        <a href={appUrl}>Sign in</a>
      </div>
      <div class="footer-col">
        <h3>Company</h3>
        <a href="/llms.txt">llms.txt</a>
        <a href="/privacy">Privacy policy</a>
        <a href="/terms">Terms of service</a>
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <div class="footer-legal">
      <span>© {year} {brandName} - a {content.legal.entity} service.</span>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </div>
    <div class="footer-meta">
      <a class="footer-built" href="https://github.com/scalevisor-io/openvisor" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        Built with Openvisor
      </a>
      <span class="footer-alpha">alpha</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 3.5rem 2rem;
    background: rgba(20, 25, 37, 0.35);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 2fr;
    gap: 2.5rem;
  }

  .wordmark {
    font-family: var(--font-brand);
    font-size: 1.2rem;
    color: var(--text-strong);
  }

  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.92rem;
    max-width: 26rem;
    margin-top: 0.75rem;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.4rem;
  }

  .footer-col a {
    color: var(--text);
    font-size: 0.92rem;
  }

  .footer-col a:hover {
    color: var(--text-strong);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.03em;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-legal a {
    color: var(--text-muted);
  }

  .footer-legal a:hover {
    color: var(--text-strong);
    text-decoration: none;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-built {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
  }

  .footer-built:hover {
    color: var(--text-strong);
    text-decoration: none;
  }

  .footer-built svg {
    display: block;
  }

  .footer-alpha {
    color: var(--alpha-red);
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 460px) {
    .footer-nav {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

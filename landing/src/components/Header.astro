---
import { appUrl, signupUrl, brandName, wordmarkHead, wordmarkTail } from '../lib/site';
import Mark from './Mark.astro';
import content, { hasSection } from '../lib/content';

// Nav links follow the sections site.yml renders; the theme switch appears
// only in toggle mode (§theme).
const toggle = content.theme?.mode === 'toggle';
const links = [
  hasSection('pillars') && { href: '/#expertise', label: 'Expertise' },
  hasSection('services') && { href: '/#services', label: 'Services' },
  hasSection('channels') && { href: '/#work-with-me', label: 'Work with me' },
  hasSection('pricing') && { href: '/#pricing', label: 'Pricing' },
  { href: '/sota', label: 'Security' },
].filter(Boolean) as { href: string; label: string }[];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label={`${brandName} home`}>
      <Mark size={22} />
      {/* one flex item: the row's gap spaces the mark from the name, never the name's own two tones */}
      <span>{wordmarkHead}<span class="gradient-text">{wordmarkTail}</span></span>
      <span class="alpha-badge" title="This platform is in alpha">alpha</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      {
        toggle && (
          <button class="theme-toggle" type="button" aria-label="Switch theme" data-theme-toggle>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        )
      }
      <a href={appUrl} class="nav-signin">Sign in</a>
      <a href={signupUrl} class="btn btn-primary btn-sm">Get started</a>
    </nav>
  </div>
</header>

<script>
  // §theme toggle: flip data-theme on <html> and remember the choice.
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const light = root.getAttribute('data-theme') !== 'light';
      if (light) root.setAttribute('data-theme', 'light');
      else root.removeAttribute('data-theme');
      try {
        localStorage.setItem('theme', light ? 'light' : 'dark');
      } catch (e) {}
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-brand);
    font-size: 1.3rem;
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .alpha-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--alpha-red);
    padding: 0.12rem 0.4rem;
    border-radius: 0.35rem;
    line-height: 1.4;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav a {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .nav a:hover {
    color: var(--text-strong);
    text-decoration: none;
  }

  .nav-signin {
    color: var(--text) !important;
  }

  /* The scoped .nav a rule outranks global .btn-primary; keep the CTA legible. */
  .nav .btn-primary {
    color: var(--gray-0);
  }

  .btn-sm {
    padding: 0.55rem 1rem;
    font-size: 0.9rem;
  }

  /* Hide secondary links on small screens; keep brand + CTA */
  @media (max-width: 640px) {
    .nav a:not(.btn):not(.nav-signin),
    .nav .theme-toggle {
      display: none;
    }
  }

  @media (max-width: 460px) {
    .nav-signin {
      display: none;
    }
  }
</style>

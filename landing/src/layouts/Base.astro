---
import '../styles/global.css';
import content, { hasSection } from '../lib/content';
import { appUrl, defaultColorPrimary, defaultColorSecondary } from '../lib/site';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { seo, legal } = content;

const {
  title = seo.title,
  description = seo.description,
  path = '/',
} = Astro.props;

// Canonical site origin comes from Astro.site (SITE_URL at build). Strip the
// trailing slash so absolute URLs and JSON-LD read like the hand-written ones.
const site = (Astro.site?.href ?? 'https://openvisor.example.com').replace(/\/$/, '');
const canonical = new URL(path, site).href;
const ogImage = new URL('/og.png', site).href;

// The runtime link-repoint script (below) needs the canonical site + app hosts.
const siteHost = Astro.site?.hostname ?? 'openvisor.example.com';
const appHost = new URL(appUrl).hostname;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: seo.orgName,
  url: site,
  logo: new URL('/favicon.svg', site).href,
  description: seo.orgDescription,
  founder: {
    '@type': 'Person',
    name: legal.consultant,
  },
  sameAs: seo.sameAs,
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: seo.serviceType,
  provider: {
    '@type': 'Organization',
    name: seo.orgName,
    url: site,
  },
  areaServed: seo.serviceAreaServed,
  description: seo.serviceDescription,
  offers: seo.offers.map((offer) => ({
    '@type': 'Offer',
    name: offer.name,
    priceCurrency: offer.priceCurrency,
    description: offer.description,
  })),
};

// §theme: site.yml style tokens, emitted as :root overrides. An unset key keeps
// the stock token from global.css; the env colour stops still apply through
// the {{BRAND_COLOR_*}} placeholders the content loader fills.
const theme = content.theme ?? {};
const paletteVars = (p: Record<string, string | undefined> = {}) => {
  const map: Record<string, string> = {
    bg: '--gray-0',
    bgElevated: '--gray-50',
    border: '--gray-100',
    text: '--gray-800',
    textMuted: '--gray-500',
    textStrong: '--gray-999',
    accent: '--accent-light',
    gradientFrom: '--speed-from',
    gradientTo: '--speed-to',
  };
  const out = Object.entries(p)
    .filter(([k, v]) => v && map[k] && v !== defaultColorPrimary + '__never')
    .map(([k, v]) => `${map[k]}:${v};`);
  if (p.gradientFrom || p.gradientTo) {
    out.push(
      `--gradient-speed:linear-gradient(135deg, ${p.gradientFrom ?? defaultColorPrimary}, ${p.gradientTo ?? defaultColorSecondary});`
    );
  }
  return out.join('');
};
const fontVars = [
  theme.fonts?.brand && `--font-brand:'${theme.fonts.brand}', var(--font-system);`,
  theme.fonts?.body && `--font-system:${theme.fonts.body};`,
  theme.fonts?.mono && `--font-mono:${theme.fonts.mono};`,
  theme.radius && `--radius:${theme.radius};`,
]
  .filter(Boolean)
  .join('');
const darkColors = { ...theme.colors };
// The stock stops are the env defaults: drop them so an unconfigured build
// emits nothing and inherits global.css verbatim.
if (darkColors.gradientFrom === defaultColorPrimary && darkColors.gradientTo === defaultColorSecondary) {
  delete darkColors.gradientFrom;
  delete darkColors.gradientTo;
}
const rootVars = paletteVars(darkColors) + fontVars;
const lightVars = paletteVars(theme.light);
const colorOverride =
  (rootVars ? `:root{${rootVars}}` : '') + (lightVars ? `html[data-theme="light"]{${lightVars}}` : '');
const themeMode = theme.mode ?? 'dark';
const htmlClass = [
  theme.ornaments?.ticks === false && 'no-ticks',
  theme.ornaments?.grid === false && 'no-grid',
  content.profile.hero.portrait && 'has-consultant-photo',
]
  .filter(Boolean)
  .join(' ');

// §profile: the consultant as a Person entity next to the Organization.
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: legal.consultant,
  jobTitle: [content.profile.hero.headline, content.profile.hero.accent].filter(Boolean).join(' '),
  url: site,
  image: content.profile.hero.portrait ? new URL(content.profile.hero.portrait, site).href : undefined,
  worksFor: { '@type': 'Organization', name: seo.orgName, url: site },
  sameAs: content.profile.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en" class={htmlClass} data-theme={themeMode === 'light' ? 'light' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={seo.themeColor} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seo.ogSiteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
    {hasSection('hero') && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />}
    {colorOverride && <style is:inline set:html={colorOverride} />}
  </head>
  <body>
    <script is:inline>
      // Marks JS availability early so scroll-reveal styles (html.js [data-reveal])
      // never hide content for no-JS visitors or crawlers.
      document.documentElement.classList.add('js');
    </script>
    {
      themeMode === 'toggle' && (
        <script is:inline>
          // §theme toggle: the visitor's choice is remembered per browser and
          // applied before first paint so the page never flashes the other theme.
          try {
            const t = localStorage.getItem('theme');
            if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
          } catch (e) {}
        </script>
      )
    }
    <slot />
    <script define:vars={{ siteHost, appHost, appUrl }}>
      // Repoint the canonical app links at the domain this page is actually
      // served from (app.openvisor.local in dev, app.<domain> wherever it's
      // deployed). Hardcoded hrefs stay as the no-JS/SEO fallback.
      (() => {
        const apex = location.hostname.replace(/^www\./, '');
        if (apex === siteHost || apex === 'localhost' || !apex.includes('.') || /^[\d.]+$/.test(apex)) return;
        document.querySelectorAll('a[href]').forEach((a) => {
          try {
            const url = new URL(a.href);
            if (url.hostname === appHost) {
              url.protocol = location.protocol;
              url.hostname = 'app.' + apex;
              url.port = location.port;
              a.href = url.toString();
            }
          } catch {
            /* leave non-URL hrefs untouched */
          }
        });
      })();

      // The API origin: the build-time app URL when this page is served from its
      // canonical host (or a bare/dev host), else app.<apex> of the host actually
      // serving it - so a landing on another domain still finds its platform.
      const apiOrigin = () => {
        const apex = location.hostname.replace(/^www\./, '');
        const sameHost =
          apex === siteHost || apex === 'localhost' || !apex.includes('.') || /^[\d.]+$/.test(apex);
        return sameHost
          ? appUrl
          : location.protocol + '//app.' + apex + (location.port ? ':' + location.port : '');
      };

      // §legal identity: the operating company's legal name and registered address
      // are admin-editable (Admin Settings -> Business legal identity) but this
      // page is a static build, so the site.yml values render first - that is what
      // crawlers and no-JS visitors read - and the admin's values are swapped in
      // here. Any failure (API down, field never set) keeps the built-in text.
      (() => {
        if (!document.querySelector('[data-legal-entity], [data-legal-address]')) return;
        fetch(apiOrigin() + '/api/meta/legal')
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            if (!d) return;
            const name = (d.legal_name || '').trim();
            // The admin types an address over several lines; it reads inline here.
            const address = (d.legal_address || '').trim().replace(/\s*\n\s*/g, ', ');
            if (name) {
              document.querySelectorAll('[data-legal-entity]').forEach((el) => {
                el.textContent = name;
              });
            }
            if (address) {
              document.querySelectorAll('[data-legal-address]').forEach((el) => {
                el.textContent = address;
              });
              document.querySelectorAll('[data-legal-address-line]').forEach((el) => {
                el.hidden = false;
              });
            }
          })
          .catch(() => {
            /* keep the values this page was built with */
          });
      })();

      // §consultant identity: the consultant's name is admin-editable (Admin
      // Settings -> Consultant) while this page is a static build, so the env
      // name renders first - that is what crawlers and no-JS visitors read - and
      // the admin's value is swapped in here, exactly like the legal identity
      // above. Any failure keeps the built-in name.
      (() => {
        const slots = document.querySelectorAll('[data-consultant-name]');
        if (!slots.length) return;
        fetch(apiOrigin() + '/api/meta/consultant')
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            if (!d) return;
            const full = (d.full_name || '').trim();
            const first = (d.first_name || '').trim();
            if (!full && !first) return;
            slots.forEach((el) => {
              const value = el.getAttribute('data-consultant-name') === 'first' ? first : full;
              if (value) el.textContent = value;
            });
          })
          .catch(() => {
            /* keep the name this page was built with */
          });
      })();

      // §consultant photo: the admin's portrait (Admin Settings -> Consultant
      // photo) is served by the API, never baked into this static build. The
      // slots may already show a committed portrait (site.yml profile.hero.
      // portrait); the API photo is probed off-DOM and swapped in only once it
      // has loaded, so a 404 (no photo yet), a network error or a blocked host
      // leaves the page exactly as built.
      (() => {
        const slots = document.querySelectorAll('img[data-consultant-photo-img]');
        if (!slots.length) return;
        const probe = new Image();
        probe.addEventListener('load', () => {
          slots.forEach((img) => {
            img.src = probe.src;
          });
          document.documentElement.classList.add('has-consultant-photo');
        });
        probe.src = apiOrigin() + '/api/meta/consultant-photo';
      })();
    </script>
  </body>
</html>

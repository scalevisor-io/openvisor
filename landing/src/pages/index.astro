---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { aiIntakeUrl, consultantName, programsUrl, signupUrl, tokensUrl } from '../lib/site';
import ConsultantName from '../components/ConsultantName.astro';
import content from '../lib/content';

// Hand-drawn inline SVG icon set - one stroke grammar (24px grid, 1.7 stroke,
// round caps) so every visual on the page reads as the same family.
const icon = (paths: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const icons: Record<string, string> = {
  pulse: icon('<path d="M3 12h4l3-7 4 14 3-7h4"/>'),
  thread: icon(
    '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><rect x="9.5" y="9.2" width="5" height="4" rx="0.8"/><path d="M10.7 9.2V8.1a1.3 1.3 0 0 1 2.6 0v1.1"/>'
  ),
  terminal: icon(
    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="m8 9 3 3-3 3"/><path d="M13 15h4"/>'
  ),
  pr: icon(
    '<circle cx="6" cy="6" r="2.6"/><circle cx="6" cy="18" r="2.6"/><circle cx="18" cy="18" r="2.6"/><path d="M6 8.6v6.8"/><path d="M12 6h3a3 3 0 0 1 3 3v6.4"/>'
  ),
  meter: icon(
    '<path d="M4 16a8 8 0 1 1 16 0"/><path d="M12 16l4.2-5"/><circle cx="12" cy="16" r="1"/>'
  ),
  key: icon(
    '<circle cx="7.5" cy="16.5" r="3.5"/><path d="m10.2 13.8 8.8-8.8"/><path d="m15.5 8.5 2.6 2.6"/><path d="m19 5 2 2"/>'
  ),
  shieldNode: icon(
    '<path d="M12 3l7 2.6v5c0 4.4-2.9 7.5-7 9.4-4.1-1.9-7-5-7-9.4v-5L12 3z"/><circle cx="12" cy="10.8" r="1.6"/><path d="M12 12.4v3"/><path d="M10.6 9.8 8.8 8.4"/><path d="m13.4 9.8 1.8-1.4"/>'
  ),
  pen: icon(
    '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>'
  ),
  globe: icon(
    '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.8 2.6 2.8 14.4 0 17-2.8-2.6-2.8-14.4 0-17z"/>'
  ),
  badge: icon(
    '<circle cx="12" cy="9" r="5.2"/><path d="m8.6 13.1-1.1 7.6 4.5-2.6 4.5 2.6-1.1-7.6"/>'
  ),
  box: icon(
    '<path d="M21 8.2 12 3 3 8.2v7.6L12 21l9-5.2V8.2z"/><path d="m3 8.2 9 5.2 9-5.2"/><path d="M12 13.4V21"/>'
  ),
  layers: icon('<path d="m12 3-9 5 9 5 9-5-9-5z"/><path d="m3 13 9 5 9-5"/>'),
  zap: icon('<path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/>'),
  check: icon('<path d="m5 13 4 4L19 7"/>'),
  message: icon(
    '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>'
  ),
};

// Animated status glyphs shown inside the chip - each signals what the phase is
// doing: hourglass (draining) = waiting on a person, chrono = timing an
// estimate, spinner = the agent is actively building (Claude Code style),
// broadcast = the demo is live, check = delivered. Styled + animated in the
// <style> block; `stroke/color: currentColor` so they inherit the chip's tone
// (amber / cyan / green).
const glyphs: Record<string, string> = {
  hourglass:
    '<svg class="chip-glyph chip-glyph--hourglass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h12M6 20h12M7.5 4 12 12 7.5 20M16.5 4 12 12 16.5 20"/><path class="hg-sand" d="M8.6 18.8h6.8L12 13z" fill="currentColor" stroke="none"/></svg>',
  chrono:
    '<svg class="chip-glyph chip-glyph--chrono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13.5" r="7"/><path d="M12 6.5V4M10 4h4"/><path class="chrono-hand" d="M12 13.5V8.2" stroke-width="2"/></svg>',
  spinner: '<span class="ascii-spin" aria-hidden="true">/</span>',
  broadcast:
    '<svg class="chip-glyph chip-glyph--live" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none"/><path class="live-w1" d="M8.3 8.3a5.2 5.2 0 0 0 0 7.4M15.7 8.3a5.2 5.2 0 0 1 0 7.4"/><path class="live-w2" d="M5.8 5.8a8.8 8.8 0 0 0 0 12.4M18.2 5.8a8.8 8.8 0 0 1 0 12.4"/></svg>',
  check:
    '<svg class="chip-glyph chip-glyph--check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="done-check" d="M5 13l4 4L19 7"/></svg>',
};

// All activity-specific copy + data lives in src/data/site.example.yml (or a
// gitignored site.yml override); see src/lib/content.ts. The icon + glyph SVG
// sets above stay in code and are referenced by id from the YAML. Phase and
// feature-request icon ids are resolved to inline SVG here so both the server
// render and the client cycle scripts (which get these via define:vars) carry
// the markup. The hero card is the customer project dashboard, cycled through
// the §8 lifecycle so a visitor watches a project move Review → Delivery;
// PHASE_START renders server-side so the first paint shows the signature build.
const { hero, channels, projects, programs, how, pricing, sovereign, finalCta } = content;

const stageLabels = content.stageLabels;
const phases = content.phases.map((phase) => ({
  ...phase,
  events: phase.events.map((ev) => ({ ...ev, icon: icons[ev.icon] })),
}));
const PHASE_START = 2; // render the "In build" phase first (signature look)

const featureRequests = content.featureRequests.map((fr) => ({
  ...fr,
  icon: icons[fr.icon],
}));

const specs = content.specs;

const platformPoints = projects.points;
const trustPoints = sovereign.trustPoints;
const steps = how.steps;
const programExamples = programs.examples;

const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<Base>
  <Header />
  <main>
    <!-- HERO ------------------------------------------------------ -->
    <section class="hero section">
      <div class="container hero-inner">
        <div>
          <p class="eyebrow hero-eyebrow rise r1">
            {hero.eyebrow[0]} <span class="sep">/</span> {hero.eyebrow[1]}
            <span class="sep">/</span> {hero.eyebrow[2]}
          </p>
          <h1 class="hero-title rise r2">
            {hero.titleLead}<br />
            <span class="gradient-text">{hero.titleAccent}</span>
          </h1>
          <p class="hero-lede rise r3">
            {hero.lede}
          </p>
          <div class="hero-cta rise r4">
            <a href={aiIntakeUrl} class="btn btn-primary">{hero.ctaPrimary}</a>
            <a href="#work-with-me" class="btn btn-ghost">{hero.ctaSecondary}</a>
          </div>
          <!-- §consultant photo: the hero signature. The ring and the name stay
               hidden until the admin's portrait loads (Base.astro flips
               html.has-consultant-photo), so a deployment without one renders
               the plain note. -->
          <div class="hero-sign rise r5">
            <span class="sign-ring">
              <img class="sign-img" alt={consultantName} data-consultant-photo-img />
            </span>
            <p class="hero-note">
              <strong class="sign-name"><ConsultantName /></strong>
              {hero.note}
            </p>
          </div>
        </div>

        <!-- Signature visual: the project dashboard, as the customer sees it -->
        <div class="hero-visual rise r4" aria-hidden="true">
          <div class="demo-card" data-crm-card>
            <div class="demo-head">
              <span class="demo-name">{hero.visualName}</span>
              <span class={`demo-chip demo-chip--${phases[PHASE_START].chip.tone}`}>
                <span
                  class="chip-indicator"
                  set:html={glyphs[phases[PHASE_START].chip.indicator]}
                />
                <span class="chip-label">{phases[PHASE_START].chip.label}</span>
              </span>
            </div>
            <ol class="demo-timeline">
              {
                stageLabels.map((label, i) => {
                  const state = phases[PHASE_START].stages[i];
                  return (
                    <li class={state ? `t-${state}` : ''}>
                      <span class="t-node">
                        {state === 'done' && <Fragment set:html={icons.check} />}
                      </span>
                      <span class="t-label">{label}</span>
                    </li>
                  );
                })
              }
            </ol>
            <div class="demo-events">
              {
                phases[PHASE_START].events.map((ev) => (
                  <div class="demo-event">
                    <span class="event-icon" set:html={ev.icon} />
                    <p class="event-body">
                      {ev.body}
                      <span class="event-meta">{ev.meta}</span>
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
          <p class="hero-visual-caption">
            {hero.visualCaption}
          </p>
        </div>
      </div>
    </section>

    <!-- SPEC STRIP -------------------------------------------------- -->
    <div class="spec-strip rise r6">
      <div class="container spec-inner">
        {specs.map((spec) => <span class="spec-item">{spec}</span>)}
      </div>
    </div>

    <!-- WAYS TO WORK: the Curated AI path's two doors (web app / the customer's
         own coding agent over MCP) and the hand-built Direct quote ------------ -->
    <section id="work-with-me" class="section channels">
      <div class="container">
        <p class="eyebrow" data-reveal><span class="eyebrow-i">01</span>{channels.eyebrow}</p>
        <h2 class="section-title" data-reveal style="--d: 60ms">{channels.title}</h2>
        {
          channels.intro && (
            <p class="section-intro" data-reveal style="--d: 120ms">
              {channels.intro}
            </p>
          )
        }

        <div class="ways-grid">
          <!-- Curated AI, from the web app -->
          <article class="way-card way-card--primary" data-reveal>
            <span class="way-glyph" set:html={icons.shieldNode} />
            <span class="way-tag">{channels.platform.tag}</span>
            <h3 class="way-title">{channels.platform.title}</h3>
            <p class="way-lede">
              {channels.platform.lede}
            </p>
            <div class="platform-surface chan-surface" set:html={channels.platform.surface} />
            <ul class="way-list">
              {channels.platform.list.map((item) => <li set:html={item} />)}
            </ul>
            <p class="way-for">
              <span>{channels.platform.forLabel}</span> {channels.platform.forText}
            </p>
            <a href={signupUrl} class="btn btn-primary way-cta">{channels.platform.cta}</a>
          </article>

          <!-- Curated AI, from the customer's own coding agent over MCP -->
          <article class="way-card way-card--primary" data-reveal style="--d: 120ms">
            <span class="way-glyph" set:html={icons.terminal} />
            <span class="way-tag">{channels.agent.tag}</span>
            <h3 class="way-title">{channels.agent.title}</h3>
            <p class="way-lede">
              {channels.agent.lede}
            </p>
            <div class="platform-surface chan-surface" set:html={channels.agent.surface} />
            <ul class="way-list">
              {channels.agent.list.map((item) => <li set:html={item} />)}
            </ul>
            <p class="way-for">
              <span>{channels.agent.forLabel}</span> {channels.agent.forText}
            </p>
            <a href={tokensUrl} class="btn btn-ghost way-cta">{channels.agent.cta}</a>
          </article>

          <!-- Hand-built, on a direct quote: full width -->
          <article class="way-card way-card--wide" data-reveal style="--d: 180ms">
            <div class="wide-main">
              <span class="way-glyph way-glyph--muted" set:html={icons.pen} />
              <span class="way-face"><img alt={consultantName} data-consultant-photo-img /></span>
              <span class="way-tag way-tag--muted">{channels.quote.tag}</span>
              <h3 class="way-title">{channels.quote.title}</h3>
              <p class="way-lede">
                {channels.quote.lede}
              </p>
              <p class="way-for">
                <span>{channels.quote.forLabel}</span> {channels.quote.forText}
              </p>
            </div>
            <ul class="way-list wide-list">
              {channels.quote.list.map((item) => <li>{item}</li>)}
            </ul>
            <a href={signupUrl} class="btn btn-ghost way-cta wide-cta">{channels.quote.cta}</a>
          </article>
        </div>
        <p class="ways-note" data-reveal>
          {channels.note}
        </p>
      </div>
    </section>

    <!-- PROJECTS ---------------------------------------------------- -->
    <section id="projects" class="section platform">
      <div class="container">
        <p class="eyebrow" data-reveal><span class="eyebrow-i">02</span>{projects.eyebrow}</p>
        <h2 class="section-title" data-reveal style="--d: 60ms">{projects.title}</h2>
        <p class="section-intro" data-reveal style="--d: 120ms">
          {projects.intro}
        </p>

        <div class="platform-grid">
          {
            platformPoints.map((point, i) => (
              <article class="platform-card" data-reveal style={`--d: ${i * 70}ms`}>
                <div class="platform-head">
                  <span class="platform-icon" set:html={icons[point.icon]} />
                  <span class="platform-i">/ {pad(i)}</span>
                </div>
                <h3 class="platform-title">{point.title}</h3>
                <div class="platform-surface" set:html={point.surface} />
                <p class="platform-caption">{point.caption}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PROGRAMS ---------------------------------------------------- -->
    <section id="programs" class="section programs">
      <div class="container">
        <p class="eyebrow" data-reveal><span class="eyebrow-i">03</span>{programs.eyebrow}</p>
        <h2 class="section-title" data-reveal style="--d: 60ms">{programs.title}</h2>
        <p class="section-intro" data-reveal style="--d: 120ms">
          {programs.intro}
        </p>

        <div class="program-examples">
          {
            programExamples.map((ex, i) => (
              <article class="program-card" data-reveal style={`--d: ${i * 70}ms`}>
                <div class="program-head">
                  <span
                    class="program-tile"
                    aria-hidden="true"
                    style={`background: linear-gradient(135deg, ${ex.from}, ${ex.to})`}
                  >
                    {ex.monogram}
                  </span>
                  <div class="program-titles">
                    <h3>{ex.title}</h3>
                    <span class="program-mode">{ex.mode}</span>
                  </div>
                </div>
                <p class="program-body">{ex.body}</p>
                <p class="program-meta">{ex.meta}</p>
              </article>
            ))
          }
        </div>
        <div class="program-run" data-program-run data-reveal>
          <div class="run-head">
            <span
              class="run-tile"
              aria-hidden="true"
              style={`background: linear-gradient(135deg, ${programExamples[0].from}, ${programExamples[0].to})`}
            >
              {programExamples[0].monogram}
            </span>
            <span class="run-name">{programExamples[0].title}</span>
            <span class="run-id">{programExamples[0].run.id}</span>
            <span class="demo-chip demo-chip--done run-chip">
              <span class="chip-indicator" set:html={glyphs.check} />
              <span class="chip-label">succeeded</span>
            </span>
          </div>
          <div class="run-log">
            {
              programExamples[0].run.lines.map((l) => (
                <p class={`run-line is-on${l.tone ? ` run-line--${l.tone}` : ''}`}>
                  <span class="run-g">{l.g}</span>
                  {l.text}
                </p>
              ))
            }
          </div>
        </div>

        <div class="programs-cta" data-reveal>
          <a href={programsUrl} class="btn btn-primary">{programs.cta}</a>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS ---------------------------------------------- -->
    <section id="how-it-works" class="section">
      <div class="container">
        <p class="eyebrow" data-reveal><span class="eyebrow-i">04</span>{how.eyebrow}</p>
        <h2 class="section-title" data-reveal style="--d: 60ms">{how.title}</h2>
        <p class="section-intro" data-reveal style="--d: 120ms" set:html={how.intro} />

        <ol class="steps">
          {
            steps.map((step, i) => (
              <li class="step" data-reveal style={`--d: ${i * 60}ms`}>
                <span class="step-n">{step.n}</span>
                <div class="step-content">
                  <h3 class="step-title">
                    {step.title}
                    {step.who && <span class="step-who">{step.who}</span>}
                  </h3>
                  <p class="step-body">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- PRICING TEASER -------------------------------------------- -->
    <section id="pricing" class="section pricing">
      <div class="container">
        <p class="eyebrow" data-reveal><span class="eyebrow-i">05</span>{pricing.eyebrow}</p>
        <h2 class="section-title" data-reveal style="--d: 60ms">{pricing.title}</h2>
        <p class="section-intro" data-reveal style="--d: 120ms">
          {pricing.intro}
        </p>

        <div class="price-grid">
          <div class="price-card price-card--accent" data-reveal>
            <span class="price-tag">{pricing.primary.tag}</span>
            <h3 class="price-title">{pricing.primary.title}</h3>
            <p>
              {pricing.primary.body}
            </p>
          </div>
          <div class="price-card" data-reveal style="--d: 120ms">
            <span class="price-tag price-tag--muted">{pricing.secondary.tag}</span>
            <h3 class="price-title">{pricing.secondary.title}</h3>
            <p>
              {pricing.secondary.body}
            </p>
          </div>
        </div>
        <div class="pricing-cta" data-reveal>
          <a href={signupUrl} class="btn btn-primary">{pricing.cta}</a>
        </div>
      </div>
    </section>

    <!-- SOVEREIGN / TRUST ------------------------------------------ -->
    <section id="sovereign" class="section sovereign">
      <div class="container sovereign-inner">
        <div data-reveal>
          <p class="eyebrow"><span class="eyebrow-i">06</span>{sovereign.eyebrow}</p>
          <h2 class="section-title">{sovereign.title}</h2>
          <p class="section-intro">
            {sovereign.intro}
          </p>
        </div>
        <ul class="trust-list">
          {
            trustPoints.map((point, i) => (
              <li data-reveal style={`--d: ${i * 70}ms`}>
                <span class="trust-icon" set:html={icons[point.icon]} />
                <span>
                  <strong>{point.strong}</strong> {point.text}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FINAL CTA -------------------------------------------------- -->
    <section class="section final-cta">
      <div class="container final-cta-inner" data-reveal>
        <h2 class="final-title">
          {finalCta.titleLead} <span class="gradient-text">{finalCta.titleAccent}</span>
        </h2>
        <p class="final-lede">
          {finalCta.lede}
        </p>
        <div class="hero-cta">
          <a href={signupUrl} class="btn btn-primary">{finalCta.ctaPrimary}</a>
          <a href={finalCta.ctaSecondaryHref} class="btn btn-ghost">{finalCta.ctaSecondaryLabel}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    // Scroll reveal: fade-rise elements as they enter the viewport.
    // html.js gates the hidden state, so no-JS visitors see everything.
    const els = document.querySelectorAll('[data-reveal]');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach((el) => io.observe(el));
  </script>

  <script define:vars={{ phases, glyphs, featureRequests, start: PHASE_START, checkIcon: icons.check }}>
    // Cycle the hero project card through the lifecycle phases every 2.3s, so the
    // visitor watches a project advance Review → Delivery. Held still for
    // reduced-motion visitors (they keep the server-rendered "In build" phase).
    const card = document.querySelector('[data-crm-card]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (card && !reduce.matches) {
      const chip = card.querySelector('.demo-chip');
      const chipLabel = card.querySelector('.chip-label');
      const chipIndicator = card.querySelector('.chip-indicator');
      const nodes = card.querySelectorAll('.demo-timeline > li');
      const list = card.querySelector('.demo-events');
      const tones = ['wait', 'build', 'done'];
      const isBuild = (i) => phases[i].chip.indicator === 'spinner';

      // Write a message's icon + copy into a .demo-event node, keeping the
      // server-rendered children (which carry Astro's scoped-style attribute).
      const setEventContent = (el, ev) => {
        el.querySelector('.event-icon').innerHTML = ev.icon;
        const body = el.querySelector('.event-body');
        const meta = body.querySelector('.event-meta');
        Array.from(body.childNodes).forEach((n) => {
          if (n !== meta) body.removeChild(n);
        });
        body.insertBefore(document.createTextNode(ev.body + ' '), meta);
        meta.textContent = ev.meta;
      };

      // Reset the message pile to exactly this phase's events (the build feed may
      // have swapped a base slot for a clone) and write their content.
      const applyEvents = (evs) => {
        let items = Array.from(list.querySelectorAll('.demo-event'));
        while (items.length > evs.length) items.pop().remove();
        items = Array.from(list.querySelectorAll('.demo-event'));
        items.forEach((el) => {
          el.style.cssText = ''; // clear any inline animation styles
        });
        items.forEach((el, n) => evs[n] && setEventContent(el, evs[n]));
      };

      // Build phase: a customer feature request slides in at the top of the pile,
      // pushing it down and collapsing the oldest message off the bottom.
      let frIdx = 0;
      let feedTimer = null;
      const insertFeatureRequest = () => {
        const items = list.querySelectorAll('.demo-event');
        if (items.length < 2) return;
        const fr = featureRequests[frIdx++ % featureRequests.length];
        const node = items[0].cloneNode(true); // clone keeps the scoped-style attrs
        node.style.cssText = '';
        setEventContent(node, fr);
        list.insertBefore(node, list.firstChild);
        const h = node.offsetHeight; // natural height before collapsing
        node.style.transition = 'none';
        node.style.maxHeight = '0px';
        node.style.opacity = '0';
        node.style.paddingTop = '0px';
        node.style.paddingBottom = '0px';
        void node.offsetHeight; // reflow so the open animates from collapsed
        node.style.transition = '';
        node.style.maxHeight = h + 'px';
        node.style.opacity = '';
        node.style.paddingTop = '';
        node.style.paddingBottom = '';
        window.setTimeout(() => {
          node.style.maxHeight = '';
        }, 500);

        // Collapse the oldest message off the bottom.
        const last = list.querySelector('.demo-event:last-child');
        if (last && last !== node) {
          last.style.maxHeight = last.offsetHeight + 'px';
          void last.offsetHeight;
          last.style.maxHeight = '0px';
          last.style.opacity = '0';
          last.style.marginTop = '0px';
          last.style.paddingTop = '0px';
          last.style.paddingBottom = '0px';
          window.setTimeout(() => last.remove(), 520);
        }
      };
      const scheduleBuildFeed = () => {
        window.clearTimeout(feedTimer);
        feedTimer = window.setTimeout(insertFeatureRequest, 1100);
      };
      const clearBuildFeed = () => window.clearTimeout(feedTimer);

      const apply = (i) => {
        const p = phases[i];
        chipLabel.textContent = p.chip.label;
        chipIndicator.innerHTML = glyphs[p.chip.indicator];
        tones.forEach((t) => chip.classList.remove('demo-chip--' + t));
        chip.classList.add('demo-chip--' + p.chip.tone);

        nodes.forEach((li, n) => {
          const st = p.stages[n];
          li.classList.remove('t-done', 't-active');
          if (st) li.classList.add('t-' + st);
          const node = li.querySelector('.t-node');
          if (node) node.innerHTML = st === 'done' ? checkIcon : '';
        });

        applyEvents(p.events);
        if (isBuild(i)) scheduleBuildFeed();
        else clearBuildFeed();
      };

      // Tick the ASCII build spinner. Runs whenever the build chip is showing
      // (its .ascii-spin span is only in the DOM during that phase).
      const frames = ['|', '/', '-', '\\'];
      let frame = 0;
      window.setInterval(() => {
        const spin = card.querySelector('.ascii-spin');
        if (spin) spin.textContent = frames[frame++ % frames.length];
      }, 130);

      // Kick off the feed for the server-rendered starting phase (build).
      if (isBuild(start)) scheduleBuildFeed();

      let idx = start;
      window.setInterval(() => {
        // Forward steps slide the comments left → right (progress); leaving the
        // last phase loops back to the first, so it just fades.
        const wrap = idx === phases.length - 1;
        card.classList.add('is-swapping');
        list.classList.add(wrap ? 'fade-exit' : 'slide-exit');
        window.setTimeout(() => {
          idx = (idx + 1) % phases.length;
          apply(idx);
          card.classList.remove('is-swapping');
          if (wrap) {
            list.classList.remove('fade-exit');
          } else {
            list.classList.remove('slide-exit');
            list.classList.add('slide-enter'); // jump to the left, no transition
            void list.offsetWidth; // reflow, then slide in from the left
            list.classList.remove('slide-enter');
          }
        }, 320);
      }, 2300);
    }
  </script>

  <script define:vars={{ programs: programExamples, glyphs }}>
    // Programs run panel: replay each example program's run - queued →
    // running (log lines stream in) → succeeded (output, webhook, billing) -
    // cycling through the catalog cards and highlighting the one playing.
    // Starts when the panel first scrolls into view; reduced-motion visitors
    // keep the server-rendered completed run.
    const panel = document.querySelector('[data-program-run]');
    const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (panel && !noMotion.matches) {
      const cards = document.querySelectorAll('.program-card');
      const tile = panel.querySelector('.run-tile');
      const name = panel.querySelector('.run-name');
      const runId = panel.querySelector('.run-id');
      const chip = panel.querySelector('.run-chip');
      const chipLabel = panel.querySelector('.chip-label');
      const chipIndicator = panel.querySelector('.chip-indicator');
      const lines = panel.querySelectorAll('.run-line');
      const tones = ['wait', 'build', 'done'];
      const CHIP = {
        queued: ['wait', 'hourglass'],
        running: ['build', 'spinner'],
        succeeded: ['done', 'check'],
      };
      const setChip = (state) => {
        tones.forEach((t) => chip.classList.remove('demo-chip--' + t));
        chip.classList.add('demo-chip--' + CHIP[state][0]);
        chipIndicator.innerHTML = glyphs[CHIP[state][1]];
        chipLabel.textContent = state;
      };

      // Rewrite a server-rendered line node in place (the node and its
      // children carry Astro's scoped-style attribute, so we keep them and
      // only swap tone classes + content).
      const lineTones = ['ok', 'file', 'hook', 'dim'];
      const setLine = (el, l) => {
        el.classList.remove('is-on');
        lineTones.forEach((t) => el.classList.remove('run-line--' + t));
        if (l.tone) el.classList.add('run-line--' + l.tone);
        const g = el.querySelector('.run-g');
        g.textContent = l.g;
        Array.from(el.childNodes).forEach((n) => {
          if (n !== g) el.removeChild(n);
        });
        el.appendChild(document.createTextNode(l.text));
      };

      // Tick the ASCII spinner while the running chip shows it.
      const frames = ['|', '/', '-', '\\'];
      let frame = 0;
      window.setInterval(() => {
        const spin = panel.querySelector('.ascii-spin');
        if (spin) spin.textContent = frames[frame++ % frames.length];
      }, 130);

      let pi = 0;
      let timers = [];
      const at = (ms, fn) => timers.push(window.setTimeout(fn, ms));
      const play = () => {
        timers.forEach(window.clearTimeout);
        timers = [];
        const ex = programs[pi];
        tile.style.background = `linear-gradient(135deg, ${ex.from}, ${ex.to})`;
        tile.textContent = ex.monogram;
        name.textContent = ex.title;
        runId.textContent = ex.run.id;
        cards.forEach((c, n) => c.classList.toggle('is-running', n === pi));
        lines.forEach((el, n) => setLine(el, ex.run.lines[n]));
        setChip('queued');
        at(900, () => setChip('running'));
        lines.forEach((el, n) => at(1150 + n * 560, () => el.classList.add('is-on')));
        const done = 1150 + lines.length * 560;
        at(done + 200, () => setChip('succeeded'));
        at(done + 2800, () => lines.forEach((el) => el.classList.remove('is-on')));
        at(done + 3180, () => {
          pi = (pi + 1) % programs.length;
          play();
        });
      };

      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            play();
          }
        },
        { threshold: 0.35 }
      );
      io.observe(panel);
    }
  </script>
</Base>

<style>
  /* MOTION ------------------------------------------------------- */
  /* Page-load rise for the hero. */
  .rise {

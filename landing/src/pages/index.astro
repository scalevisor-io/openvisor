<!-- Chip status glyphs. These live in an is:global block because the SVGs are
     injected via set:html / innerHTML and never receive Astro's scoped-style
     attribute - a scoped rule would not match them and the animations would
     silently never run. Namespaced under .chip-indicator so nothing leaks. -->
<style is:global>
  .chip-indicator .chip-glyph {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Hourglass (In review): the whole glyph flips over. The rotation swings
     through horizontal, so the motion reads clearly even at chip size (a subtle
     sand-drain was invisible this small). */
  .chip-indicator .chip-glyph--hourglass {
    transform-origin: 50% 50%;
    animation: hg-flip 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes hg-flip {
    0%,
    16% {
      transform: rotate(0deg);
    }
    50%,
    66% {
      transform: rotate(180deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Chrono (Estimating): a stopwatch hand sweeps the dial continuously. */
  .chip-indicator .chrono-hand {
    transform-box: view-box;
    transform-origin: 12px 13.5px;
    animation: chrono-sweep 1.4s linear infinite;
  }
  @keyframes chrono-sweep {
    to {
      transform: rotate(360deg);
    }
  }

  /* ASCII spinner (In build): the classic | / - \ CLI spinner. Pure ASCII so it
     renders in any monospace font; the client script ticks the character via
     textContent. No-JS / reduced-motion visitors keep the static baked frame. */
  .chip-indicator .ascii-spin {
    display: inline-block;
    width: 0.62rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
  }

  /* Broadcast (Live demo): signal waves pulse outward, staggered so they ripple. */
  .chip-indicator .live-w1,
  .chip-indicator .live-w2 {
    opacity: 0.2;
    animation: live-wave 1.8s ease-out infinite;
  }
  .chip-indicator .live-w2 {
    animation-delay: 0.45s;
  }
  @keyframes live-wave {
    0% {
      opacity: 0.15;
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0.15;
    }
  }

  /* Check (Delivered): the tick draws itself, then gives a small pop. */
  .chip-indicator .chip-glyph--check {
    transform-origin: 50% 50%;
    animation: check-pop 3s ease-in-out infinite;
  }
  .chip-indicator .done-check {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    animation: check-draw 3s ease-in-out infinite;
  }
  @keyframes check-draw {
    0% {
      stroke-dashoffset: 24;
    }
    22%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  @keyframes check-pop {
    0%,
    22%,
    100% {
      transform: scale(1);
    }
    32% {
      transform: scale(1.22);
    }
    44% {
      transform: scale(1);
    }
  }

  /* Projects card surfaces: the in-progress "Build" dot breathes. */

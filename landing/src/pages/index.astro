---
// The home page is a list of sections rendered in the order site.yml gives
// (`sections:`, see src/lib/content.ts). Each section is a component under
// src/components/home/; the copy lives in src/data/site.yml. Numbered
// sections get their running index from their position in that list.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/home.css';

import { sections, type SectionId } from '../lib/content';
import HeroProfile from '../components/home/HeroProfile.astro';
import SpecStrip from '../components/home/SpecStrip.astro';
import Pillars from '../components/home/Pillars.astro';
import Services from '../components/home/Services.astro';
import Proof from '../components/home/Proof.astro';
import Channels from '../components/home/Channels.astro';
import Platform from '../components/home/Platform.astro';
import Programs from '../components/home/Programs.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Pricing from '../components/home/Pricing.astro';
import Sovereign from '../components/home/Sovereign.astro';
import About from '../components/home/About.astro';
import FinalCta from '../components/home/FinalCta.astro';

const registry: Record<SectionId, { component: any; numbered: boolean }> = {
  hero: { component: HeroProfile, numbered: false },
  specs: { component: SpecStrip, numbered: false },
  pillars: { component: Pillars, numbered: true },
  services: { component: Services, numbered: true },
  proof: { component: Proof, numbered: true },
  channels: { component: Channels, numbered: true },
  platform: { component: Platform, numbered: true },
  programs: { component: Programs, numbered: true },
  how: { component: HowItWorks, numbered: true },
  pricing: { component: Pricing, numbered: true },
  sovereign: { component: Sovereign, numbered: true },
  about: { component: About, numbered: true },
  finalCta: { component: FinalCta, numbered: false },
};

let count = 0;
const plan = sections.map((id) => {
  const entry = registry[id];
  const n = entry.numbered ? String(++count).padStart(2, '0') : '';
  return { id, Component: entry.component, n };
});
---

<Base>
  <Header />
  <main>
    {plan.map(({ Component, n }) => (n ? <Component n={n} /> : <Component />))}
  </main>
  <Footer />

  <script>
    // Scroll reveal: fade-rise elements as they enter the viewport.
    // html.js gates the hidden state, so no-JS visitors see everything.
    const els = document.querySelectorAll('[data-reveal]');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach((el) => io.observe(el));
  </script>
</Base>

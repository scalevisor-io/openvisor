  /* Fixed slot for the per-phase status glyph, so the chip width never jitters
     as the dot / hourglass / chrono / spinner swap in. */
  .chip-indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 13px;
    height: 13px;
    color: var(--chip-accent);
  }

  /* The chip glyphs themselves (.chip-glyph*, .ascii-spin, wave/hand/check
     parts) are injected via set:html / innerHTML, so they never carry Astro's
     scoped-style attribute. Their styles + keyframes therefore live in the
     is:global block below, or the animations would silently never apply. */

  .demo-timeline {
    display: flex;
    list-style: none;
    margin: 1.6rem 0 0.4rem;
    padding: 0;
  }

  .demo-timeline li {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
  }

  /* Connector between two nodes: a gray track (::before) with a cyan fill
     (::after) that grows left → right, so each segment fills progressively as
     the project advances. */
  .demo-timeline li:not(:first-child)::before,
  .demo-timeline li:not(:first-child)::after {
    content: '';
    position: absolute;
    top: 11px;
    left: calc(-50% + 14px);
    right: calc(50% + 14px);
    height: 2px;
  }
  .demo-timeline li:not(:first-child)::before {
    background: var(--gray-100);
  }
  .demo-timeline li:not(:first-child)::after {
    background: color-mix(in srgb, var(--speed-from) 70%, transparent);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 0.6s ease;
  }
  .demo-timeline li.t-done:not(:first-child)::after,
  .demo-timeline li.t-active:not(:first-child)::after {
    transform: scaleX(1);
  }
  /* The segment reaching from the active node toward the next stage keeps
     filling on a loop - work is in progress. */
  .demo-timeline li.t-active + li:not(:first-child)::after {
    transform: scaleX(0);
    animation: line-fill 1.6s ease-in-out infinite;
  }
  @keyframes line-fill {
    0% {
      transform: scaleX(0);
      opacity: 0.85;
    }
    65% {
      transform: scaleX(1);
      opacity: 0.85;
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-timeline li.t-active + li:not(:first-child)::after {
      animation: none;
    }
  }

  .t-node {

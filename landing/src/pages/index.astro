  .r1 { animation-delay: 0.05s; }
  .r2 { animation-delay: 0.12s; }
  .r3 { animation-delay: 0.2s; }
  .r4 { animation-delay: 0.28s; }
  .r5 { animation-delay: 0.36s; }
  .r6 { animation-delay: 0.44s; }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }

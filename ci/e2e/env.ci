# CI e2e: the .env the end-to-end workflow copies into place. Every value is a
# throwaway for a job-scoped stack - nothing here is a secret, which is why it
# can live in a committed file (same rule as ci/deploy.gitlab-ci.yml). The
# backend crashes on a MISSING required var, so this lists all of them.
COMPOSE_PROJECT_NAME=openvisor
DEPLOY_ENV=local
DEPLOY_DOMAIN=openvisor.local
DEPLOY_BASE_IP=127.0.0.1
TRAEFIK_HTTP_PORT=8080
TRAEFIK_DASHBOARD_PORT=8081
DEMOS_NETWORK=openvisor-demos
APP_BASE_URL=http://app.openvisor.local:8080
LANDING_BASE_URL=http://openvisor.local:8080

DATABASE_URL=postgresql+asyncpg://openvisor:openvisor@postgres:5432/openvisor
REDIS_URL=redis://redis:6379/0
SECRET_KEY=ci-only-secret-key-not-production
MASTER_ENCRYPTION_KEY=ci-only-encryption-key-not-production
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=ci-only-admin-password

# The captcha widget needs a secure context; the walkthrough is plain http.
ALTCHA_ENABLED=0

# No model in CI: 127.0.0.1:1 refuses the connection instantly (a blackholed
# host would burn the retry backoff on every call), LLM_MAX_RETRIES=0 makes the
# heuristic fallbacks immediate, and the LLM-only features are switched off.
OPENAI_BASE_URL=http://127.0.0.1:1/v1
OPENAI_API_KEY=ci-throwaway
OPENAI_MODEL=ci-model
EMBEDDING_BASE_URL=http://127.0.0.1:1/v1
EMBEDDING_API_KEY=ci-throwaway
EMBEDDING_MODEL=ci-embedding-model
RERANKER_BASE_URL=http://127.0.0.1:1/v1
RERANKER_API_KEY=ci-throwaway
RERANKER_MODEL=ci-reranker-model
LLM_MAX_RETRIES=0
CHAT_CLASSIFY_ENABLED=0
CHAT_ANSWER_ENABLED=0
WORK_ANSWER_ENABLED=0
PROJECT_SEARCH_AI_ENABLED=0
ACCEPTANCE_CHECKS_ENABLED=0
SECURITY_REVIEW_ENABLED=0
DEV_PLAN_CONFIRM=0

MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=ci-throwaway-meili-key
CONTEXT7_MCP_URL=http://context7:3000/mcp
CONTEXT7_API_KEY=

# Scaffold mode: the deterministic placeholder build goes through the exact
# same push -> merge -> deploy path as a real agent run, at zero token cost.
OPENHANDS_ENABLED=0
OPENHANDS_URL=
DEMO_RUNTIME=
DEV_SANDBOX_DOCKER=0
DEMO_PORT_RANGE=20000-30000
DEMO_CPU_LIMIT=1
DEMO_MEM_LIMIT=2g
DEMO_TIMEOUT_MINUTES=30
DEMO_HEALTHCHECK_TIMEOUT=120

GITLAB_URL=http://localhost:1
GITLAB_TOKEN=ci-throwaway
GITLAB_GROUP=ci
GITLAB_SSH_HOST=
GITHUB_TOKEN=

STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_AUTOMATIC_TAX=0

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Openvisor CI <ci@example.org>

CREDIT_CURRENCY=EUR
CREDIT_MARKUP=1.3

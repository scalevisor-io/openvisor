# Core (under compose these values work as-is - they point at the bundled services)
DATABASE_URL=postgresql+asyncpg://openvisor:openvisor@postgres:5432/openvisor
REDIS_URL=redis://redis:6379/0
SECRET_KEY=
MASTER_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_BASE_URL=https://app.openvisor.example.com
LANDING_BASE_URL=https://openvisor.example.com

# Deployment
DEPLOY_ENV=production            # production | local
DEPLOY_BASE_IP=203.0.113.10      # public IP of the host (demo DNS target)
DEPLOY_DOMAIN=openvisor.example.com  # openvisor.local when DEPLOY_ENV=local
DEMO_PORT_RANGE=20000-30000
DEMO_CPU_LIMIT=1
DEMO_MEM_LIMIT=2g
DEMO_TIMEOUT_MINUTES=15
DEMO_HEALTHCHECK_TIMEOUT=60      # seconds the demo app gets to answer HTTP after compose up (0 disables)
DEMO_RUNTIME=sysbox-runc         # empty locally (falls back to --privileged DinD)
DEV_SANDBOX_DOCKER=0             # 1 = dev-run sandboxes get an inner docker daemon (Sysbox via DEMO_RUNTIME, else --privileged local fallback); worker + deployer read the same flag

# Models (OpenAI-compatible)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
# Optional: retries on a transient chat failure (429 rate limit / 5xx) with
# exponential backoff. Defaults to 4; set 0 to disable.
LLM_MAX_RETRIES=4

# Meilisearch (retrieval engine for the local /knowledge KB - hybrid BM25 + vector).
# MEILI_URL defaults to the in-network service; MEILI_MASTER_KEY is REQUIRED (OCPA:
# no default) - generate a strong random key. After first deploy, run a one-time
# reindex (POST /api/admin/knowledge/reindex or the ingest_knowledge task).
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=
# Anti-extraction retrieval floor: drop retrieved KB chunks whose hybrid ranking
# score (0..1) is below this, so an off-topic corpus-sweep query returns nothing
# instead of the top-k least-bad matches. 0.5-0.7 is stricter (less leakage, lower
# recall); 0 disables. Tune per corpus. Optional (default 0.5).
KB_RETRIEVAL_MIN_SCORE=0.5

# Agent
CONTEXT7_MCP_URL=http://context7:3000/mcp
CONTEXT7_API_KEY=
# Local KB: the gitignored `./knowledge` folder, mounted read-only at /knowledge (no env var).
# Cloud knowledge sources are managed at runtime (forthcoming git-KB feature).
OPENHANDS_URL=                   # optional external OpenHands runtime; empty = local scaffold fallback

# GitLab
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_GROUP=
# Optional: the hostname your GitLab serves SSH on, when it differs from
# GITLAB_URL's host (e.g. GITLAB_URL=https://gitlab.example.com while clones read
# git@git.example.com:10022/...). Repos cloned over that name are then recognised
# as YOUR GitLab - they detect as `gitlab` instead of `other` (so issue watching
# and MR integration work), and their API calls go to GITLAB_URL with
# GITLAB_TOKEN instead of to an SSH hostname that need not serve /api/v4.
# Leave empty when both hostnames are the same.
GITLAB_SSH_HOST=

# GitHub (customer-owned repos). Platform-wide fallback token used only when a
# project has no GITHUB_TOKEN Memory secret of its own. Empty is fine: without
# any token the agent still pushes its branch and the customer opens/merges the
# PR manually (the merge is detected over SSH). A per-project GITHUB_TOKEN also
# unlocks the AI security review + auto-merge when Auto-merge is toggled on. A
# customer GitLab push repo works the same way with a per-project GITLAB_TOKEN
# Memory secret (no platform fallback - the token above is for the platform host).
GITHUB_TOKEN=
# AI security review of the agent's PR/MR before an auto-merge. SECURITY_FIX_ATTEMPTS
# bounds how many times a critical/high finding re-dispatches a scoped fix run
# before the project is parked for customer review. SECURITY_REVIEW_ENABLED=0
# turns the review off (auto-merge then only checks the deterministic floor).
SECURITY_REVIEW_ENABLED=1
SECURITY_FIX_ATTEMPTS=10

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# BROWSER_MCP_URL=http://browser-mcp:3000/mcp   # dev agent's browser tool (Playwright MCP sidecar); optional, this is the default

# Brand (your white-label identity - set these before going live).
# The SPA reads these at runtime via GET /api/settings; the landing bakes them
# at BUILD time (rebuild the landing image after changing them). SITE_URL is the
# landing's canonical origin; the landing's activity-specific copy lives in
# landing/src/data/site.example.yml (copy to site.yml to override wholesale).
#BRAND_NAME=Openvisor
#BRAND_COLOR_PRIMARY=#22d3ee
#BRAND_COLOR_SECONDARY=#7c3aed
#CONSULTANT_NAME=Jane Doe
# One-line description of your consulting practice - the moderation, chat and
# knowledge prompts speak from it. Default: "software & infrastructure consulting".
#CONSULTANT_FOCUS=cloud infrastructure consulting for healthcare companies
#SITE_URL=https://openvisor.example.com

# Billing
CREDIT_CURRENCY=EUR
CREDIT_MARKUP=1.3

# Hub (optional; leave unset for a standalone spoke). When HUB_MCP_URL is set,
# the spoke registers with and heartbeats to a central Scalevisor Hub over MCP,
# authenticating with HUB_SPOKE_TOKEN. HUB_MAX_GRANT_CREDITS caps one
# hub-initiated credit grant (fail-loud guard against a misbehaving hub).
# INSTANCE_CAPABILITIES declares what this instance offers the hub network,
# comma-separated: "development" (executes projects, the default) and/or
# "project_management" (fronts engagements that orchestrate other spokes).
#HUB_MCP_URL=
#HUB_SPOKE_TOKEN=
#HUB_MAX_GRANT_CREDITS=10000
#INSTANCE_CAPABILITIES=development
